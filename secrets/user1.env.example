# user1.env - settings for one account. Copy to secrets/<name>.env (e.g. user1.env),
# replace the example values and run: chmod 600 secrets/*.env
# Format: KEY=value, one per line. Comments only on their own line (a '#' after a value
# belongs to the value, so passwords may contain '#').

# =============================================================================
# ACCOUNT
# =============================================================================
# Name used in logs and heartbeat messages (default: the file name without .env)
ACCOUNT_ID=user1

# Address of the WEB.DE account to keep alive
ACCOUNT_EMAIL=user@example.com

# Password used for the IMAP login: WEB.DE password or an app-specific password
ACCOUNT_PASSWORD=replace_with_password

# IMAP server (WEB.DE defaults, IMAP over SSL)
ACCOUNT_IMAP_HOST=imap.web.de
ACCOUNT_IMAP_PORT=993
# Optional, overrides [IMAP] timeout in webdekeepalive.config
#ACCOUNT_IMAP_TIMEOUT=30

# =============================================================================
# SCHEDULE (read by deploy/install-systemd.sh for this account's systemd timer)
# =============================================================================
# When the login runs, in systemd calendar syntax (see 'man systemd.time').
# Every run starts at a new random time up to 90 minutes later. Give every account
# its own time, e.g. Sun 10:00 for the first and Sun 17:30 for the second, so the
# logins do not happen together like a bot. Check with: systemd-analyze calendar "Sun 10:00"
SCHEDULE=Sun 10:00

# =============================================================================
# HEARTBEAT (optional, one Uptime Kuma push monitor for this account)
# =============================================================================
# Leave empty to use only the global heartbeat from webdekeepalive.config
HEARTBEAT_URL=

# =============================================================================
# REPORT MAIL (optional)
# =============================================================================
# Send a short report mail after every run (once a week). Usually not needed when
# Uptime Kuma is set up.
MAIL_SEND=false

# SMTP server: port 465 = SSL, any other port (587) = STARTTLS
MAIL_SMTP_HOST=smtp.web.de
MAIL_SMTP_PORT=465

# Recipient (default: ACCOUNT_EMAIL) and sender name
MAIL_TO_EMAIL=user@example.com
ACCOUNT_FROM_NAME=webdekeepalive

# SMTP login, only needed if it differs from ACCOUNT_EMAIL / ACCOUNT_PASSWORD
#ACCOUNT_SMTP_USER=user@example.com
#ACCOUNT_SMTP_PASS=replace_with_password

# Templates, use \n for line breaks. Placeholders:
# {account} {email} {time} {status} (OK/FAILED) {message} {log_excerpt} {hostname}
TEMPLATE_SUBJECT=WEB.DE KeepAlive [{status}] {time} - {email}
TEMPLATE_BODY=Hello,\n\nthis is the KeepAlive report for your WEB.DE account.\n\nAccount: {email}\nTime: {time}\nStatus: {status}\nMessage: {message}\n\nLog of this run:\n{log_excerpt}\n\nRegards, webdekeepalive on {hostname}
